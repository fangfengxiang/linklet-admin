# Server-only backend origin: change this for a different Linklet host/domain.
LINKLET_BACKEND=http://127.0.0.1:18080
# Local BFF business-API identity; never use UMI_APP_ or client defines for SK.
LINKLET_ACCESS_KEY=
LINKLET_SECRET_KEY=
# docker compose local Linklet source and port
LINKLET_SOURCE=../../linklet
LINKLET_LOCAL_PORT=18080
LINKLET_ENCRYPTION_KEY=
