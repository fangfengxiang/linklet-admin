{
  "name": "linklet-admin",
  "version": "0.1.0",
  "private": true,
  "description": "React management console for the Linklet short-link platform",
  "scripts": {
    "dev": "max dev",
    "build": "max build",
    "tsc": "tsc --noEmit",
    "lint": "npm run lint:eslint && npm run tsc",
    "lint:eslint": "eslint src --ext .ts,.tsx",
    "prettier": "prettier --write src/**/*.{ts,tsx}",
    "preview": "max preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "e2e run --exclude-tag agent",
    "e2e:serve": "max build && max preview"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@ant-design/pro-components": "^2.8.2",
    "antd": "^5.22.2",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.15.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@umijs/max": "^4.3.27",
    "@vitejs/plugin-react": "^4.7.0",
    "e2e": "^0.21.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "happy-dom": "^15.11.7",
    "prettier": "^3.4.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  }
}
